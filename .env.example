# Copy this file to `.env` in the project root (same folder as pubspec.yaml).
# Never commit `.env` — it is listed in .gitignore.
#
# See docs/SUPABASE_KEYS_AND_OTP.md for where to find each value in Supabase.

# --- Supabase (required for supabase_flutter) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here

# Optional: only for server-side scripts / Edge Functions — NEVER ship in the Flutter app
# SUPABASE_SERVICE_ROLE_KEY=

# --- Firebase (existing app — optional if you still use Firebase) ---
# FIREBASE_* keys are usually in Firebase Console → Project settings, not Supabase.
